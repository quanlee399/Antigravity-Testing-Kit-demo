				{
					"name": "TC_PET_001: [Happy Path] Create a new pet",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var randomId = Math.floor(100000 + Math.random() * 900000);",
									"var timestamp = Date.now();",
									"pm.collectionVariables.set('createdPetId', randomId);",
									"pm.collectionVariables.set('petName', 'auto_pet_' + timestamp);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Pet created with correct ID and name', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.eql(parseInt(pm.collectionVariables.get('createdPetId')));",
									"    pm.expect(jsonData.name).to.eql(pm.collectionVariables.get('petName'));",
									"    pm.expect(jsonData.status).to.eql('available');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "api_key", "value": "{{apiKey}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": {{createdPetId}},\n  \"category\": { \"id\": 1, \"name\": \"Dogs\" },\n  \"name\": \"{{petName}}\",\n  \"photoUrls\": [\"https://example.com/pet.jpg\"],\n  \"tags\": [{ \"id\": 1, \"name\": \"friendly\" }],\n  \"status\": \"available\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/pet", "host": ["{{baseUrl}}"], "path": ["pet"] }
					}
