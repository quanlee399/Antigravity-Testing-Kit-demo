							"mode": "raw",
							"raw": "{\n  \"firstname\": \"DynamicJim\",\n  \"lastname\": \"Brown\",\n  \"totalprice\": 111,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-09-01\",\n    \"checkout\": \"2026-09-10\"\n  }\n}"
						},
