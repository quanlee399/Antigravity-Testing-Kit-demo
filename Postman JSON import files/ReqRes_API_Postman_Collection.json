					}
				},
				{
					"name": "TC_REQRES_USER_002: [Happy Path] Create new user",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var timestamp = Date.now();",
									"pm.collectionVariables.set('userName', 'morpheus_' + timestamp);",
									"pm.collectionVariables.set('userJob', 'leader');"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('User created with generated id and createdAt', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.name).to.eql(pm.collectionVariables.get('userName'));",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.collectionVariables.set('createdUserId', jsonData.id);",
									"});"
								],
								"type": "text/javascript"
							}
